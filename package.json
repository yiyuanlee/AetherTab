{
  "name": "aethertab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Save Chrome tabs into collections, import and organize bookmarks. Local workspace, no account needed.",
  "homepage": "https://aethertab.com/",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "icons": "python generate_icons.py icons",
    "dev": "echo Load unpacked in chrome://extensions — no dev server needed",
    "test:preview": "node scripts/run-test-preview.mjs",
    "promo": "node scripts/capture-promo.mjs",
    "preview:site": "wrangler dev",
    "deploy:site": "wrangler deploy"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "^1.62.1",
    "wrangler": "^4.133.0"
  }
}
