{
  "manifest_version": 3,
  "name": "AetherTab",
  "version": "1.2.0",
  "description": "A premium, glassmorphic tab manager to organize your workspace beautifully — with cross-device sync.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "favicon",
    "geolocation"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
