{
  "manifest_version": 3,
  "name": "AetherTab",
  "version": "1.5.3",
  "description": "A calm tab and bookmark workspace with local smart organization, portable sharing, and optional sync.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "bookmarks",
    "favicon",
    "geolocation"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
