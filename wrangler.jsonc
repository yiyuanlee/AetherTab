{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aethertab",
  "main": "./site-worker.js",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
